# Production values and the Railway rollout procedure live in
# docs/deploy/railway-runbook.md.

# Postgres (docker-compose defaults)
# If another Postgres already uses 5432 locally, set POSTGRES_HOST_PORT in a
# gitignored root .env (docker compose reads it) and match the port here.
# POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://macgrading:macgrading@localhost:5432/macgrading

# S3-compatible storage (MinIO locally, Railway bucket in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=macgrading
S3_SECRET_KEY=macgrading
S3_BUCKET=slab-photos
S3_REGION=us-east-1

# Auth
JWT_SECRET=dev-secret-do-not-use-in-production
# Accepted Google token audiences, comma-separated (web client, iOS client, …).
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com

# Seeded admin users (comma-separated emails; optional)
ADMIN_EMAILS=

# Public read base for photos, used verbatim with no bucket segment
# (e.g. Cloudflare R2's https://pub-<hash>.r2.dev). Unset in dev: MinIO
# serves ${S3_ENDPOINT}/${S3_BUCKET} directly.
# S3_PUBLIC_BASE_URL=

# Dev-only: accept any email as a login token (NEVER enable in production)
# Dev sign-in additionally requires NODE_ENV=development — it's refused
# whenever NODE_ENV is anything else, including unset.
# AUTH_DEV_MODE=true
# NODE_ENV=development

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:3000

# Public rate limiting (per IP)
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=120

# CardboardTens card catalog (leave unset to use the built-in stub)
# CARDBOARDTENS_API_KEY=ct_live_...
# CARDBOARDTENS_API_URL=https://www.cardboardtens.com/api/v1

# Browser-side API base for the web /admin section (defaults to localhost:3001)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Public site origin baked into cert QR codes and share links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google OAuth web client ID — enables the admin Google sign-in button
# (dev email sign-in shows when unset). Must also be the API's GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
