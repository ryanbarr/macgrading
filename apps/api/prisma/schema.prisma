generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEAM_MEMBER
}

enum CertStatus {
  PENDING_GRADE
  GRADED
  VOIDED
}

enum CertCounterType {
  STANDARD
  PROTOTYPE
  TEST_STANDARD
  TEST_PROTOTYPE
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  googleId    String?  @unique
  role        Role     @default(TEAM_MEMBER)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  gradedCerts Cert[] @relation("GradedCerts")
  voidedCerts Cert[] @relation("VoidedCerts")
  createdCerts Cert[] @relation("CreatedCerts")
}

model Cert {
  id              String     @id @default(uuid())
  certNumber      String     @unique
  isPrototype     Boolean
  isTest          Boolean    @default(false)
  status          CertStatus @default(PENDING_GRADE)

  // Card snapshot, copied from CardboardTens at mint time (spec: certs are
  // append-mostly ledger records; cardboardTensId is provenance only).
  cardboardTensId String
  cardName        String
  setName         String
  cardNumber      String?
  releaseYear     Int?
  category        String?
  cardImageUrl    String?
  variants        String[]   @default([])

  grade      Decimal?  @db.Decimal(4, 1)
  gradeName  String?
  gradedById String?
  gradedBy   User?     @relation("GradedCerts", fields: [gradedById], references: [id])
  gradedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("VoidedCerts", fields: [voidedById], references: [id])
  voidedAt   DateTime?
  voidReason String?
  createdById String?
  createdBy  User?     @relation("CreatedCerts", fields: [createdById], references: [id])
  createdAt  DateTime  @default(now())
  photos     CertPhoto[]

  @@index([createdAt])
}

model CertPhoto {
  id          String   @id @default(uuid())
  certId      String
  cert        Cert     @relation(fields: [certId], references: [id])
  objectKey   String   @unique
  contentType String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([certId])
}

model CertCounter {
  type      CertCounterType @id
  nextValue Int             @default(1)
}

model GradeName {
  gradeValue Decimal @id @db.Decimal(4, 1)
  name       String
}
